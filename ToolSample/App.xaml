<Application x:Class="ToolSample.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ToolSample.ViewModels"
             xmlns:views="clr-namespace:ToolSample.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- ViewModel → View DataTemplate 매핑 -->
        <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
            <views:ConnectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
            <views:RegisterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EventViewModel}">
            <views:EventView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GraphViewModel}">
            <views:GraphView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogViewModel}">
            <views:LogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProViewModel}">
            <views:ProView />
        </DataTemplate>
    </Application.Resources>
</Application>