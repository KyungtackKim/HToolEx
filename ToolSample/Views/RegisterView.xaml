<UserControl x:Class="ToolSample.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 함수 코드 / 주소 / 카운트 -->
        <GroupBox Grid.Row="0" Header="Request" Margin="0,0,0,12">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Function:" VerticalAlignment="Center" Margin="0,0,0,8" />
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                          ItemsSource="{Binding FunctionCodes}"
                          SelectedItem="{Binding SelectedFunctionCode}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Address:" VerticalAlignment="Center" Margin="0,0,0,8" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Address}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Count:" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Count}" Width="80" HorizontalAlignment="Left" />
            </Grid>
        </GroupBox>

        <!-- 쓰기 파라미터 -->
        <GroupBox Grid.Row="1" Header="Write Parameters" Margin="0,0,0,12">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Single Value:" VerticalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding WriteValue}" Width="120"
                         HorizontalAlignment="Left" Margin="0,0,0,8" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Multi Values:" VerticalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WriteValues}" Margin="0,0,0,8"
                         ToolTip="Comma separated: 100, 200, 300" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="String:" VerticalAlignment="Center" Margin="0,0,0,8" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WriteString}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="String Length:" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding StringLength}" Width="80"
                         HorizontalAlignment="Left"
                         ToolTip="0 = auto" />
            </Grid>
        </GroupBox>

        <!-- 실행 / 초기화 버튼 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Execute" Width="100" Height="32" Margin="0,0,12,0"
                    Command="{Binding ExecuteCommand}" />
            <Button Content="Clear" Width="80" Height="32"
                    Command="{Binding ClearCommand}" />
        </StackPanel>

        <!-- 결과 DataGrid -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Results}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.IsVirtualizing="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F8F8F8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="80" />
                <DataGridTextColumn Header="Hex" Binding="{Binding HexValue}" Width="100" />
                <DataGridTextColumn Header="Decimal" Binding="{Binding DecValue}" Width="100" />
                <DataGridTextColumn Header="ASCII" Binding="{Binding AsciiValue}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>