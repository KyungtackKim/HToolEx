<UserControl x:Class="ToolSample.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 필터 -->
        <GroupBox Grid.Row="0" Header="Category Filter" Margin="0,0,0,8">
            <WrapPanel Margin="8">
                <CheckBox Content="Packet" IsChecked="{Binding FilterPacket}" Margin="0,0,16,0" />
                <CheckBox Content="Connection" IsChecked="{Binding FilterConnection}" Margin="0,0,16,0" />
                <CheckBox Content="Pipeline" IsChecked="{Binding FilterPipeline}" Margin="0,0,16,0" />
                <CheckBox Content="Pro" IsChecked="{Binding FilterPro}" Margin="0,0,16,0" />
                <CheckBox Content="Error" IsChecked="{Binding FilterError}" Margin="0,0,16,0" />
                <CheckBox Content="KeepAlive" IsChecked="{Binding FilterKeepAlive}" />
            </WrapPanel>
        </GroupBox>

        <!-- 버튼 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Pause" Width="80" Height="28" Margin="0,0,8,0"
                    Command="{Binding TogglePauseCommand}" />
            <Button Content="Clear" Width="80" Height="28" Margin="0,0,8,0"
                    Command="{Binding ClearCommand}" />
            <Button Content="Export" Width="80" Height="28"
                    Command="{Binding ExportCommand}" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="{Binding IsPaused, StringFormat='Paused: {0}'}"
                       Foreground="Orange" />
        </StackPanel>

        <!-- 로그 DataGrid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Logs}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.IsVirtualizing="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F8F8F8"
                  x:Name="LogGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="100" />
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" />
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70" />
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>