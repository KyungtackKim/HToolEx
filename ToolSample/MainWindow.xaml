<Window x:Class="ToolSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ToolSample.Converters"
        Title="HTool V2 Sample"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:ConnectionToBrushConverter x:Key="ConnectionToBrush" />
        <converters:ConnectionToStringConverter x:Key="ConnectionToString" />
    </Window.Resources>

    <DockPanel>
        <!-- StatusBar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0"
                             Fill="{Binding ConnectionState, Converter={StaticResource ConnectionToBrush}}" />
                    <TextBlock Text="{Binding ConnectionState, Converter={StaticResource ConnectionToString}}" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ComTypeText, StringFormat='Type: {0}'}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ModelText, StringFormat='Model: {0}'}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SerialText, StringFormat='S/N: {0}'}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding FirmwareText, StringFormat='FW: {0}'}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ErrorText}" Foreground="Red" />
            </StatusBarItem>
        </StatusBar>

        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="180"
                BorderBrush="LightGray" BorderThickness="0,0,1,0">
            <ListBox ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding SelectedPage}"
                     DisplayMemberPath="Name"
                     Margin="4"
                     BorderThickness="0" />
        </Border>

        <!-- Content area -->
        <ContentControl Content="{Binding CurrentPage}" Margin="8" />
    </DockPanel>
</Window>