<Window x:Class="ToolRunner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ToolRunner.Converters"
        xmlns:models="clr-namespace:ToolRunner.Models"
        Title="HANTAS Tool Runner"
        Icon="Assets/ToolRunner.ico"
        Width="400" Height="700"
        MinWidth="400" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.Resources>
        <converters:ConnectionToBrushConverter x:Key="ConnectionToBrush" />
        <converters:ConnectionToStringConverter x:Key="ConnectionToString" />
        <converters:DirectionToStringConverter x:Key="DirectionToString" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <DockPanel>
        <!-- status bar: link state and sequence progress — stays visible even when the right
             panel is collapsed, so control-only use still shows what the cycle is doing -->
        <StatusBar DockPanel.Dock="Bottom">
            <!-- pin the panel so DockPanel.Dock="Right" works on the version item and the error
                 item still fills whatever space is left in the middle -->
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0"
                             Fill="{Binding ConnectionState, Converter={StaticResource ConnectionToBrush}}" />
                    <TextBlock Text="{Binding ConnectionState, Converter={StaticResource ConnectionToString}}" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding StepText, StringFormat='Step: {0}'}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding CycleCount, StringFormat='Cycle: {0}'}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding DirectionText, StringFormat='Direction: {0}'}" />
            </StatusBarItem>
            <Separator />
            <!-- docked right so the version stays pinned to the far end of the bar; declared before
                 the error item because that one fills whatever space is left in between -->
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding VersionText}" Foreground="Gray" Margin="8,0,4,0" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding ErrorText}" Foreground="Red" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <!-- left: the control column — connection, sequence timings, manual commands -->
        <DockPanel DockPanel.Dock="Left" Width="380">

            <!-- docked at the bottom of the control column so it keeps its place while the
                 settings above scroll: collapses the right-hand panel and shrinks the window
                 to control-only width -->
            <Button DockPanel.Dock="Bottom" Style="{StaticResource ActionButton}"
                    HorizontalAlignment="Left" MinWidth="170" Margin="8,4,8,8"
                    Content="{Binding DetailsToggleText}"
                    Command="{Binding ToggleDetailsCommand}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">

                    <!-- connection settings -->
                    <GroupBox Header="Connection (MODBUS-TCP)" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="IP address" />
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldInput}"
                                     Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="Port" />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldInput}"
                                     PreviewTextInput="OnDigitOnlyInput"
                                     Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="Slave ID" />
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldInput}"
                                     PreviewTextInput="OnDigitOnlyInput"
                                     Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                      Content="Enable keep-alive (detect silent disconnect)"
                                      IsChecked="{Binding KeepAliveEnabled}" />

                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <Button Style="{StaticResource ActionButton}" Content="Connect"
                                        Command="{Binding ConnectCommand}" />
                                <Button Style="{StaticResource ActionButton}" Content="Disconnect"
                                        Command="{Binding DisconnectCommand}" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- repeating cycle timings -->
                    <GroupBox Header="Sequence" Padding="8" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="① Wait before run (ms)" />
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldInput}"
                                     PreviewTextInput="OnDigitOnlyInput"
                                     ToolTip="wait before every Run command — after Start and after each direction switch"
                                     Text="{Binding WaitBeforeRunMs, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="② CW run duration (ms)" />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldInput}"
                                     PreviewTextInput="OnDigitOnlyInput"
                                     ToolTip="how long the tool runs in each CW (fastening) cycle before the Stop command"
                                     Text="{Binding CwRunDurationMs, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="③ CCW run duration (ms)" />
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldInput}"
                                     PreviewTextInput="OnDigitOnlyInput"
                                     ToolTip="how long the tool runs in each CCW (loosening) cycle before the Stop command"
                                     Text="{Binding CcwRunDurationMs, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Text="Initial direction" />
                            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,3,0,3"
                                      ItemsSource="{Binding Directions}"
                                      SelectedItem="{Binding InitialDirection}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource DirectionToString}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <Button Style="{StaticResource ActionButton}" Content="Start"
                                        Command="{Binding StartSequenceCommand}" />
                                <Button Style="{StaticResource ActionButton}" Content="Stop"
                                        Command="{Binding StopSequenceCommand}" />
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                       Foreground="Gray" TextWrapping="Wrap"
                                       Text="Registers: 5000 = Run(1)/Stop(0), 5001 = CW(0)/CCW(1). Each Stop is followed by a fixed 250 ms settle, then the direction switch. A Stop is always written when the sequence ends." />
                        </Grid>
                    </GroupBox>

                    <!-- one-off commands for manual verification -->
                    <GroupBox Header="Manual Control" Padding="8" Margin="0,8,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Style="{StaticResource ActionButton}" Content="Run"
                                        Command="{Binding ManualRunCommand}" />
                                <Button Style="{StaticResource ActionButton}" Content="Stop"
                                        Command="{Binding ManualStopCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <Button Style="{StaticResource ActionButton}" Content="Direction CW"
                                        Command="{Binding SetDirectionCommand}"
                                        CommandParameter="{x:Static models:RunDirection.Cw}" />
                                <Button Style="{StaticResource ActionButton}" Content="Direction CCW"
                                        Command="{Binding SetDirectionCommand}"
                                        CommandParameter="{x:Static models:RunDirection.Ccw}" />
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0" Foreground="Gray"
                                       Text="Disabled while the sequence runs." />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- right: controller identity on top, activity log below — collapsible as one unit -->
        <Grid Margin="0,8,8,8"
              Visibility="{Binding IsDetailsVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- device Information block read with FC 0x04 from address 1 -->
            <GroupBox Grid.Row="0" Header="Tool Information (FC 0x04, 30002–30055)" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                               Text="Driver ID" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}"
                               Text="{Binding DriverIdText}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"
                               Text="Driver model" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}"
                               Text="{Binding DriverModelText}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"
                               Text="Driver S/N" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}"
                               Text="{Binding DriverSerialText}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}"
                               Text="Firmware" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}"
                               Text="{Binding FirmwareText}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}"
                               Text="MAC address" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValue}"
                               Text="{Binding MacAddressText}" />

                    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <Button Style="{StaticResource ActionButton}" Content="Refresh"
                                Command="{Binding RefreshToolInformationCommand}" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- command / response / connection history -->
            <GroupBox Grid.Row="1" Header="Activity Log" Padding="6" Margin="0,8,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                HorizontalAlignment="Left" Margin="0,0,0,6">
                        <Button Style="{StaticResource ActionButton}" Content="Clear"
                                Command="{Binding ClearLogCommand}" />
                    </StackPanel>
                    <!-- DataGrid rather than ListView: only its star-sized column keeps the
                         message text inside the panel instead of overflowing to the right -->
                    <DataGrid x:Name="LogList" ItemsSource="{Binding Logs}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              FontFamily="Consolas" FontSize="12">
                        <!-- colour the whole row by category so failures stand out while scanning -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Category}" Value="error">
                                        <Setter Property="Foreground" Value="#C62828" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="warn">
                                        <Setter Property="Foreground" Value="#E65100" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Width="90"
                                                Binding="{Binding TimeText}" />
                            <DataGridTextColumn Header="Category" Width="90"
                                                Binding="{Binding Category}" />
                            <DataGridTextColumn Header="Message" Width="*"
                                                Binding="{Binding Message}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
