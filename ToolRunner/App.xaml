<Application x:Class="ToolRunner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- caption column style shared by every settings grid -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,8,3" />
        </Style>

        <!-- value column style for the read-only tool information panel -->
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>

        <!-- editable field style used by the connection and sequence inputs -->
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="Padding" Value="3,2" />
        </Style>

        <!-- action button style used by every command button -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Application.Resources>
</Application>
